<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Les mêmes deux droits que l'extension de partage, et pour la même raison : ce sont
	     les deux seuls canaux par lesquels les deux processus se parlent. Voir
	     ios/Partage/Partage.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.ghostbit</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.dev.ghostbit</string>
	</array>
</dict>
</plist>
