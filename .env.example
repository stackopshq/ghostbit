# Storage backend: "sqlite" or "redis"
STORAGE_BACKEND=sqlite

# SQLite (used when STORAGE_BACKEND=sqlite)
SQLITE_PATH=./ghostbit.db
# Docker / production: SQLITE_PATH=/data/ghostbit.db

# Connection pool size. WAL mode lets several readers progress in parallel;
# SQLite serializes writers internally. Bump if
# `ghostbit_sqlite_pool_wait_seconds` P99 shows contention.
# SQLITE_POOL_SIZE=5

# Redis (used when STORAGE_BACKEND=redis)
REDIS_URL=redis://localhost:6379
# Optional Redis password. If set, injected into REDIS_URL automatically.
# For an external Redis that already includes credentials in the URL, leave this empty.
# REDIS_PASSWORD=

# Max paste size in bytes (default: 524288 = 512 KB)
MAX_PASTE_SIZE=524288

# Webhook signing secret (optional).
# If set, every webhook delivery includes X-Ghostbit-Signature: sha256=<HMAC-SHA256>.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# WEBHOOK_SECRET=

# Rate limits (slowapi syntax: "N/period"). CREATE also covers the
# state-changing routes (PUT/DELETE and the HTML delete form).
RATE_LIMIT_CREATE=30/minute
RATE_LIMIT_VIEW=120/minute

# Access logging (Docker image only; default: off). When true, uvicorn logs
# every request: client IP, paste ID, timestamp. That is personal data:
# put a retention on the logs and mention them in your privacy notice.
# ACCESS_LOG=false

# Who operates THIS instance, rendered into the /privacy notice, which must
# name the data controller (GDPR art. 13 / nLPD art. 19). Empty values fall
# back to neutral wording; set all three for a public deployment.
# PRIVACY_OPERATOR="Example Corp (Germany)"
# PRIVACY_CONTACT_URL=https://example.com/contact
# PRIVACY_AUTHORITY="the BfDI (Germany)"

# Bearer token protecting GET /metrics (optional). Empty = endpoint open.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Prometheus scrape config: `authorization: { credentials: <token> }`.
# METRICS_TOKEN=

# Trust X-Forwarded-For for rate limiting. Enable ONLY when behind a
# reverse proxy. The *rightmost* XFF entry is used (the IP appended by the
# nearest hop), so the proxy itself decides the rate-limit key. For multi-
# hop setups (CDN → LB → app), configure the proxy to collapse the chain
# to a single trusted entry, otherwise the rightmost IP will be the LB and
# rate limits will apply globally rather than per-client.
TRUST_PROXY_HEADERS=false

# Public base URL: scheme + host, no trailing slash (e.g. https://paste.example.com).
# Builds the absolute URLs in social-preview meta tags (og:image, og:url) so
# link-unfurl bots (iMessage, Slack, …) can fetch the preview image. Leave empty
# to derive it from the request; set it when a TLS-terminating proxy would
# otherwise make the app advertise http:// URLs. A bad value fails fast at startup.
# BASE_URL=

# Repo whose stargazer count the footer shows, fetched server-side once an hour.
# Leave empty to disable the outbound call entirely (air-gapped deployments):
# the footer then just links to GitHub without a number.
# GITHUB_REPO=stackopshq/ghostbit

# ── Association des applications mobiles ─────────────────────────────────────
#
# Ces trois variables alimentent /.well-known/apple-app-site-association et
# /.well-known/assetlinks.json, les deux fichiers sans lesquels un lien de paste
# s'ouvre toujours dans le navigateur — même quand l'application est installée,
# et sans qu'aucune erreur ne soit produite nulle part.
#
# Les valeurs ci-dessous sont celles des applications publiées par StackOps. Une
# instance auto-hébergée qui ne distribue pas sa propre application n'a rien à
# régler : laisser IOS_APP_IDS tel quel est sans effet tant qu'aucune application
# signée par cette équipe ne déclare le domaine dans ses entitlements.

# App ID complet : <TeamID>.<bundleID>. Le bundle seul ne suffit pas, et l'erreur
# ne se voit pas — iOS ouvre simplement Safari. Plusieurs valeurs séparées par des
# virgules.
# IOS_APP_IDS=9WHCJ5W7S6.dev.ghostbit.ghostbit

# Nom de paquet Android, tel qu'il est dans android/app/build.gradle.kts.
# ANDROID_PACKAGE_NAME=dev.ghostbit.ghostbit

# SHA-256 du certificat qui signe l'APK, au format de `keytool -list -v` :
# 32 paires hexadécimales séparées par des deux-points. Plusieurs valeurs séparées
# par des virgules — Play App Signing en impose deux, la clé d'envoi et celle que
# Google substitue.
#
# **Sans valeur, /.well-known/assetlinks.json rend 503 en le disant.** C'est
# délibéré : un fichier servi avec une empreinte absente ou fausse est accepté par
# le serveur, rejeté par Android, et Android ne le signale à personne. Un 503
# lisible au curl vaut mieux qu'un fichier qui a l'air juste.
#
# Où la trouver :
#   - Play Console > Configuration > Intégrité de l'application > Signature
#   - ou, pour un APK déjà construit :
#       keytool -printcert -jarfile app-release.apk
# ANDROID_CERT_FINGERPRINTS=

# Server port (default: 8000)
PORT=8000
